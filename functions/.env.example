# ============================================================================
#  Variables de entorno del módulo LinkedIn (Cloud Functions)
#
#  Copia este archivo a `.env` y completa los valores reales.
#  El archivo `.env` está en .gitignore y NUNCA debe subirse al repositorio.
#
#  Los valores SECRETOS (CLIENT_SECRET, TOKEN_ENCRYPTION_KEY, OPENAI_API_KEY)
#  deben configurarse además como Firebase Secrets para producción:
#    firebase functions:secrets:set LINKEDIN_CLIENT_SECRET
#    firebase functions:secrets:set TOKEN_ENCRYPTION_KEY
#    firebase functions:secrets:set OPENAI_API_KEY
# ============================================================================

# --- Públicos / no secretos (pueden ir en .env normal o como params) ---
# ID de cliente de tu app en LinkedIn Developer Portal
LINKEDIN_CLIENT_ID=

# URL EXACTA de callback. Debe coincidir con la registrada en LinkedIn.
# Será la URL de la función `linkedinOAuthCallback` que imprime el deploy, p. ej.:
#   https://us-central1-cofre-education-group.cloudfunctions.net/linkedinOAuthCallback
LINKEDIN_REDIRECT_URI=

# A dónde vuelve el usuario en tu sitio tras conectar (éxito o error)
LINKEDIN_FRONTEND_RETURN_URL=https://www.cofreeducationgroup.cl/linkedin.html

# Versión de la API REST de LinkedIn (formato AAAAMM)
LINKEDIN_API_VERSION=202405

# --- SECRETOS (usar Firebase Secrets en producción) ---
# Secreto de cliente de la app LinkedIn
LINKEDIN_CLIENT_SECRET=

# Clave de cifrado de tokens (AES-256-GCM). 32 bytes en base64.
# Genérala con:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# OPCIONAL: solo si quieres recomendaciones IA reales vía OpenAI.
# Si se deja vacío, el sistema usa un generador local de ideas (sin IA externa).
OPENAI_API_KEY=
